<Window x:Class="WizFileUltra.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WizFile Ultra - Detaylı Dosya &amp; Klasör Arama (WPF .NET 4.8)"
        Height="820" Width="1240" MinHeight="680" MinWidth="1050"
        WindowStartupLocation="CenterScreen"
        Background="#F8FAFC" FontFamily="Segoe UI" FontSize="13">

    <Window.Resources>
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Background" Value="#0EA5E9"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#0284C7"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SuccessBtn" TargetType="Button" BasedOn="{StaticResource PrimaryBtn}">
            <Setter Property="Background" Value="#10B981"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#059669"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SecondaryBtn" TargetType="Button">
            <Setter Property="Background" Value="#E2E8F0"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#CBD5E1"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ÜST DETAYLI ARAMA & FİLTRE PANELİ -->
        <Border Grid.Row="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="14,12">
            <StackPanel>
                <!-- 1. Satır: Dosya Adı Araması, Klasör İsmi Araması & Tekrar Tara Butonu -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="280"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Dosya Adı Arama -->
                    <TextBlock Text="📄 Dosya Adı:" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,8,0" Foreground="#0F172A"/>
                    <TextBox x:Name="TxtSearch" Grid.Column="1" Padding="8,6" FontSize="13.5" BorderBrush="#CBD5E1"
                             ToolTip="Aramak istediğiniz dosya kelimelerini yazın (örn: rapor 2024 final). Uzantı ekleyebilirsiniz (.cpp .h)."
                             TextChanged="FilterInputChanged"/>

                    <!-- Klasör İsmi Detaylı Arama -->
                    <TextBlock Grid.Column="2" Text="📁 Klasör İsmi:" VerticalAlignment="Center" FontWeight="Bold" Margin="14,0,8,0" Foreground="#0F172A"/>
                    <TextBox x:Name="TxtFolderNameSearch" Grid.Column="3" Padding="8,6" FontSize="13.5" BorderBrush="#CBD5E1"
                             ToolTip="Dosyanın bulunduğu klasörün adını veya yolundaki bir parçayı yazın (örn: Windows, Downloads, src\components)"
                             TextChanged="FilterInputChanged"/>

                    <!-- Tümünü Yeniden Tara -->
                    <Button x:Name="BtnRescanAll" Grid.Column="4" Margin="12,0,0,0" Content="⚡ Tüm Dosyaları Tekrar Tara"
                            Style="{StaticResource PrimaryBtn}" Click="BtnRescanAll_Click"/>
                </Grid>

                <!-- 2. Satır: Sabit Klasör Kökü Ekleme (+ ile Rozetler) & Sürücü -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="📍 Hedef Dizinler:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,0" Foreground="#334155"/>

                    <TextBox x:Name="TxtFolderInput" Grid.Column="1" Padding="6,4" BorderBrush="#CBD5E1"
                             ToolTip="Sabit arama kökü eklemek için klasör yolu yazın veya Gözat ile seçin."/>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="8,0,0,0">
                        <Button Content="Gözat..." Width="70" Height="28" Style="{StaticResource SecondaryBtn}" Click="BtnBrowse_Click"/>
                        <Button Content="➕ Listeye Ekle" Margin="6,0,0,0" Width="105" Height="28" Style="{StaticResource SuccessBtn}"
                                ToolTip="Bu kök klasörü filtre rozetlerine ekler" Click="BtnAddFolder_Click"/>
                    </StackPanel>

                    <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="14,0,0,0">
                        <TextBlock Text="Sürücü:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#64748B"/>
                        <ComboBox x:Name="CmbDrives" Width="125" Height="28" VerticalContentAlignment="Center"/>
                    </StackPanel>

                    <Button x:Name="BtnScanSelectedFolders" Grid.Column="4" Margin="10,0,0,0" Content="📂 Yalnızca Seçili Klasörleri İndeksle"
                            Style="{StaticResource SecondaryBtn}" Click="BtnScanSelectedFolders_Click"/>
                </Grid>

                <!-- Eklenen Klasör Rozetleri (Chips) -->
                <ItemsControl x:Name="IcFolders" Margin="110,0,0,8">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="12" Margin="0,0,6,6" Padding="8,3">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📁 " FontSize="11"/>
                                    <TextBlock Text="{Binding}" Foreground="#1E40AF" FontSize="11" Margin="2,0,6,0" VerticalAlignment="Center"/>
                                    <Button Content="✖" Foreground="#EF4444" Background="Transparent" BorderThickness="0" Cursor="Hand"
                                            FontSize="10" Padding="2,0" Tag="{Binding}" Click="BtnRemoveFolder_Click"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- 3. Satır: Uzantılar (.cpp .h), Boyut, Tarih, Dosya/Klasör Radyoları -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Uzantılar:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,0" Foreground="#334155"/>
                    <TextBox x:Name="TxtCustomExt" Grid.Column="1" Padding="6,4" BorderBrush="#CBD5E1"
                             Text=".txt .cpp .h .c .cs .py .js .ts .html .css .json .xml .md .log"
                             ToolTip="Varsayılan metin ve kod formatları. İstediğiniz gibi silebilir veya ekleyebilirsiniz." TextChanged="FilterInputChanged"/>

                    <TextBlock Grid.Column="2" Text="Boyut:" VerticalAlignment="Center" Margin="14,0,8,0" Foreground="#64748B"/>
                    <ComboBox x:Name="CmbSize" Grid.Column="3" Height="28" VerticalContentAlignment="Center">
                        <ComboBoxItem Content="Herhangi" IsSelected="True"/>
                        <ComboBoxItem Content="&lt; 1 MB (Küçük)"/>
                        <ComboBoxItem Content="1 MB - 100 MB"/>
                        <ComboBoxItem Content="100 MB - 1 GB"/>
                        <ComboBoxItem Content="&gt; 1 GB (Çok Büyük)"/>
                    </ComboBox>

                    <TextBlock Grid.Column="4" Text="Tarih:" VerticalAlignment="Center" Margin="14,0,8,0" Foreground="#64748B"/>
                    <ComboBox x:Name="CmbDate" Grid.Column="5" Height="28" VerticalContentAlignment="Center">
                        <ComboBoxItem Content="Herhangi" IsSelected="True"/>
                        <ComboBoxItem Content="Bugün"/>
                        <ComboBoxItem Content="Son 7 Gün"/>
                        <ComboBoxItem Content="Son 30 Gün"/>
                        <ComboBoxItem Content="Bu Yıl"/>
                    </ComboBox>

                    <StackPanel Grid.Column="6" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <RadioButton x:Name="RbAll" Content="Tümü" IsChecked="True" Margin="0,0,10,0"/>
                        <RadioButton x:Name="RbFilesOnly" Content="Sadece Dosyalar" Margin="0,0,10,0"/>
                        <RadioButton x:Name="RbFoldersOnly" Content="Sadece Klasörler"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- DATA GRID (VIRTUALIZING 60FPS) -->
        <DataGrid x:Name="DgResults" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionMode="Single" SelectionUnit="FullRow" CanUserSortColumns="True"
                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F1F5F9"
                  HeadersVisibility="Column" RowHeight="28" BorderThickness="0" Background="White"
                  EnableRowVirtualization="True" EnableColumnVirtualization="True"
                  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                  Sorting="DgResults_Sorting" MouseDoubleClick="DgResults_MouseDoubleClick" KeyDown="DgResults_KeyDown">

            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="▶ Dosyayı / Klasörü Aç" Click="MenuOpen_Click"/>
                    <MenuItem Header="📂 Bulunduğu Klasörü Aç ve Seç" Click="MenuOpenFolder_Click"/>
                    <Separator/>
                    <MenuItem Header="📋 Tam Dosya Yolunu Kopyala (Ctrl+C)" Click="MenuCopyPath_Click"/>
                    <MenuItem Header="📋 Yalnızca Klasör Yolunu Kopyala" Click="MenuCopyDir_Click"/>
                </ContextMenu>
            </DataGrid.ContextMenu>

            <DataGrid.Columns>
                <DataGridTextColumn Header="Adı" Binding="{Binding Name}" Width="320"/>
                <DataGridTextColumn Header="Bulunduğu Klasör / Yol" Binding="{Binding DirectoryPath}" Width="*"/>
                <DataGridTextColumn Header="Uzantı" Binding="{Binding Extension}" Width="80"/>
                <DataGridTextColumn Header="Boyut" Binding="{Binding FormattedSize}" Width="110"/>
                <DataGridTextColumn Header="Değiştirilme Tarihi" Binding="{Binding FormattedDate}" Width="150"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- STATUS BAR -->
        <Border Grid.Row="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="12,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="TxtStatus" Text="Hazırlanıyor..." VerticalAlignment="Center" Foreground="#475569"/>
                <ProgressBar x:Name="PbStatus" Grid.Column="1" Width="140" Height="14" IsIndeterminate="True" Visibility="Collapsed" Margin="0,0,12,0"/>
                <TextBlock x:Name="TxtCount" Grid.Column="2" Text="0 öğe" FontWeight="Bold" VerticalAlignment="Center" Foreground="#0F172A"/>
            </Grid>
        </Border>
    </Grid>
</Window>
