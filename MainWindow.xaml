<Window x:Class="WizFileUltra.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WizFile Ultra - Hedef Dizin &amp; İçerik Arama Motoru (WPF .NET 4.8)"
        Height="840" Width="1350" MinHeight="680" MinWidth="1050"
        WindowStartupLocation="CenterScreen"
        Background="#F8FAFC" FontFamily="Segoe UI" FontSize="13">

    <Window.Resources>
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Background" Value="#0EA5E9"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#0284C7"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SuccessBtn" TargetType="Button" BasedOn="{StaticResource PrimaryBtn}">
            <Setter Property="Background" Value="#10B981"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#059669"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DangerBtn" TargetType="Button" BasedOn="{StaticResource PrimaryBtn}">
            <Setter Property="Background" Value="#EF4444"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#DC2626"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SecondaryBtn" TargetType="Button">
            <Setter Property="Background" Value="#E2E8F0"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#CBD5E1"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ÜST PANEL -->
        <Border Grid.Row="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="14,12">
            <StackPanel>
                <!-- 1. Satır: Aranacak Dosya Adı, [+] Dosya Ekle, [-] Temizle, Dil, Debug Log & Tekrar Tara -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Aranacak Dosya Adı Girişi -->
                    <TextBlock x:Name="LblFileName" Text="📄 Dosya Adı:" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,8,0" Foreground="#0F766E" FontSize="13.5"/>
                    <TextBox x:Name="TxtSearch" Grid.Column="1" Padding="8,6" FontSize="13.5" BorderBrush="#14B8A6" TextChanged="FilterInputChanged"
                             KeyDown="TxtSearch_KeyDown" ToolTip="Aranacak dosya adını yazın (örn: asdadasda.txt). [+] butonuna basarak veya Enter'a basarak listeye ekleyebilirsiniz."/>

                    <!-- [+] Dosya Adı Ekle Butonu -->
                    <Button x:Name="BtnAddFileName" Grid.Column="2" Content="➕ Dosya Ekle" Margin="8,0,4,0" Width="95" Height="32"
                            Style="{StaticResource SuccessBtn}" Click="BtnAddFileName_Click" ToolTip="Yazdığınız dosya adını arama listesine ekler."/>

                    <!-- [-] Dosya Adlarını Temizle / Sil Butonu -->
                    <Button x:Name="BtnClearFileNames" Grid.Column="3" Content="➖ Temizle" Margin="4,0,14,0" Width="85" Height="32"
                            Style="{StaticResource DangerBtn}" Click="BtnClearFileNames_Click" ToolTip="Tüm eklenmiş dosya adı filtrelerini temizler."/>

                    <!-- Dil Seçimi -->
                    <StackPanel Grid.Column="4" Orientation="Horizontal" Margin="0,0,10,0">
                        <TextBlock Text="🌐" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <ComboBox x:Name="CmbLanguage" Width="82" Height="32" VerticalContentAlignment="Center">
                            <ComboBoxItem Content="TR (Türkçe)" Tag="tr" IsSelected="True"/>
                            <ComboBoxItem Content="EN (English)" Tag="en"/>
                            <ComboBoxItem Content="DE (Deutsch)" Tag="de"/>
                            <ComboBoxItem Content="FR (Français)" Tag="fr"/>
                            <ComboBoxItem Content="ES (Español)" Tag="es"/>
                            <ComboBoxItem Content="RU (Русский)" Tag="ru"/>
                            <ComboBoxItem Content="ZH (中文)" Tag="zh"/>
                            <ComboBoxItem Content="JA (日本語)" Tag="ja"/>
                            <ComboBoxItem Content="AR (العربية)" Tag="ar"/>
                        </ComboBox>
                    </StackPanel>

                    <!-- Debug Log Butonu -->
                    <Button x:Name="BtnViewLog" Grid.Column="5" Content="📜 Debug Log" Margin="0,0,10,0" Height="32"
                            Style="{StaticResource SecondaryBtn}" Click="BtnViewLog_Click" ToolTip="Hata ve debug günlüğünü görüntüler."/>

                    <!-- Tümünü Tekrar Tara -->
                    <Button x:Name="BtnRescanAll" Grid.Column="6" Content="⚡ Tümünü Tekrar Tara"
                            Style="{StaticResource PrimaryBtn}" Click="BtnRescanAll_Click"/>
                </Grid>

                <!-- Eklenen Çoklu Aranacak Dosya Adı Rozetleri -->
                <ItemsControl x:Name="IcFileNames" Margin="135,0,0,6">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#CCFBF1" BorderBrush="#99F6E4" BorderThickness="1" CornerRadius="12" Margin="0,0,6,6" Padding="8,3">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📄 " FontSize="11"/>
                                    <TextBlock Text="{Binding}" Foreground="#0F766E" FontWeight="Bold" FontSize="11" Margin="2,0,6,0" VerticalAlignment="Center"/>
                                    <Button Content="➖" Foreground="#EF4444" Background="Transparent" BorderThickness="0" Cursor="Hand"
                                            FontSize="10" Padding="2,0" Tag="{Binding}" Click="BtnRemoveFileName_Click" ToolTip="Bu dosya adını aramadan çıkar"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- 2. Satır: Dosya İçi Kelime Arama, [+] Kelime Ekle, [-] Kelimeleri Temizle -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Aranacak Kelime Girişi -->
                    <TextBlock x:Name="LblContentSearch" Text="🔍 Aranacak Kelime:" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,8,0" Foreground="#0284C7" FontSize="13.5"/>
                    <TextBox x:Name="TxtContentSearch" Grid.Column="1" Padding="8,6" FontSize="13.5" BorderBrush="#38BDF8" TextChanged="FilterInputChanged"
                             KeyDown="TxtContentSearch_KeyDown" ToolTip="Dosyaların içinde aranacak kelimeyi yazın (örn: sadasdasdas). [+] butonuna basarak veya Enter'a basarak listeye ekleyin."/>

                    <!-- [+] Kelime Ekle Butonu -->
                    <Button x:Name="BtnAddWord" Grid.Column="2" Content="➕ Kelime Ekle" Margin="8,0,4,0" Width="105" Height="32"
                            Style="{StaticResource SuccessBtn}" Click="BtnAddWord_Click" ToolTip="Yazdığınız kelimeyi arama listesine ekler."/>

                    <!-- [-] Kelimeleri Temizle / Sil Butonu -->
                    <Button x:Name="BtnClearWords" Grid.Column="3" Content="➖ Temizle" Margin="4,0,0,0" Width="85" Height="32"
                            Style="{StaticResource DangerBtn}" Click="BtnClearWords_Click" ToolTip="Tüm eklenmiş arama kelimelerini temizler."/>
                </Grid>

                <!-- Eklenen Çoklu Aranacak Kelime Rozetleri ([+] ile eklenenler ve [-] ile tek tek çıkarılanlar) -->
                <ItemsControl x:Name="IcWords" Margin="135,0,0,6">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#E0F2FE" BorderBrush="#BAE6FD" BorderThickness="1" CornerRadius="12" Margin="0,0,6,6" Padding="8,3">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🔍 " FontSize="11"/>
                                    <TextBlock Text="{Binding}" Foreground="#0369A1" FontWeight="Bold" FontSize="11" Margin="2,0,6,0" VerticalAlignment="Center"/>
                                    <Button Content="➖" Foreground="#EF4444" Background="Transparent" BorderThickness="0" Cursor="Hand"
                                            FontSize="10" Padding="2,0" Tag="{Binding}" Click="BtnRemoveWord_Click" ToolTip="Bu kelimeyi aramadan çıkar"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- 2. Satır: Hedef Dizinler (+ Rozetler) & Sürücü -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="LblTargetFolders" Text="📍 Hedef Dizinler:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,0" Foreground="#334155"/>
                    <TextBox x:Name="TxtFolderInput" Grid.Column="1" Padding="6,4" BorderBrush="#CBD5E1"
                             ToolTip="Arama yapılacak klasör yolunu yazın veya Gözat ile seçip [+] butonuna basın."/>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="8,0,0,0">
                        <Button x:Name="BtnBrowse" Content="Gözat..." Width="70" Height="28" Style="{StaticResource SecondaryBtn}" Click="BtnBrowse_Click"/>
                        <Button x:Name="BtnAddFolder" Content="➕ Dizin Ekle" Margin="6,0,0,0" Width="105" Height="28" Style="{StaticResource SuccessBtn}" Click="BtnAddFolder_Click"/>
                    </StackPanel>

                    <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="14,0,0,0">
                        <TextBlock x:Name="LblDrive" Text="Sürücü:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#64748B"/>
                        <ComboBox x:Name="CmbDrives" Width="125" Height="28" VerticalContentAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Column="4" Orientation="Horizontal" Margin="10,0,0,0">
                        <Button x:Name="BtnScanSelectedFolders" Content="📂 Yalnızca Bu Dizini Tara &amp; İndeksle"
                                Style="{StaticResource SecondaryBtn}" Click="BtnScanSelectedFolders_Click" ToolTip="Seçilen klasörü/klasörleri tarayıp arama veritabanına ekler."/>
                        <Button x:Name="BtnDirectTargetSearch" Content="⚡ Bu Dizinde Kelimeyi &amp; Uzantıyı Ara" Margin="8,0,0,0"
                                Style="{StaticResource PrimaryBtn}" Click="BtnDirectTargetSearch_Click" ToolTip="Seçilen dizindeki dosyaları taze tarayıp girdiğiniz kelime ve uzantıya (.txt vb.) göre anında listeler."/>
                        <!-- Taramayı Durdur Butonu -->
                        <Button x:Name="BtnStopScan" Content="⏹ Taramayı Durdur" Margin="8,0,0,0" Width="135"
                                Style="{StaticResource DangerBtn}" Click="BtnStopScan_Click" Visibility="Collapsed" ToolTip="Devam eden taramayı anında durdurur ve o ana kadar taranmış dosyaları aramaya işler."/>
                    </StackPanel>
                </Grid>

                <!-- Eklenen Hedef Dizin Rozetleri (Folder Chips) -->
                <ItemsControl x:Name="IcFolders" Margin="110,0,0,8">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="12" Margin="0,0,6,6" Padding="8,3">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📁 " FontSize="11"/>
                                    <TextBlock Text="{Binding}" Foreground="#1E40AF" FontSize="11" Margin="2,0,6,0" VerticalAlignment="Center"/>
                                    <Button Content="➖" Foreground="#EF4444" Background="Transparent" BorderThickness="0" Cursor="Hand"
                                            FontSize="10" Padding="2,0" Tag="{Binding}" Click="BtnRemoveFolder_Click" ToolTip="Bu dizini aramadan çıkar"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- 3. Satır: Uzantılar (.txt, .cs vb.) ve Arama Butonları -->
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="LblExtensions" Text="📄 Uzantılar:" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,8,0" Foreground="#334155" FontSize="13"/>
                    <TextBox x:Name="TxtCustomExt" Grid.Column="1" Padding="6,5" BorderBrush="#CBD5E1" FontSize="12.5"
                             Text=".txt .cpp .h .c .cs .py .js .ts .html .css .json .xml .md .log"
                             TextChanged="FilterInputChanged" ToolTip="Aranacak uzantıları yazın (örn: .txt .cs .log). Boş bırakırsanız tüm uzantılarda arar."/>

                    <!-- Doğrudan Arama Yap Butonu -->
                    <Button x:Name="BtnDirectSearch" Grid.Column="2" Content="🔎 Filtrelere Göre Ara" Margin="10,0,0,0" Width="170" Height="32"
                            Style="{StaticResource PrimaryBtn}" Click="BtnManualRefresh_Click" ToolTip="Girdiğiniz dizin, dosya adı, kelime ve uzantı filtrelerine göre anında arama yapar."/>

                    <!-- Tüm Diski Baştan İndeksle Butonu -->
                    <Button x:Name="BtnIndexAllDrives" Grid.Column="3" Content="⚡ Tüm Diski İndeksle" Margin="8,0,0,0" Width="160" Height="32"
                            Style="{StaticResource SuccessBtn}" Click="BtnRescanAll_Click" ToolTip="Tüm sabit diskleri (C:, D: vb.) MFT üzerinden hızlıca baştan indeksler."/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- ORTA BÖLÜM: DATA GRID VE YAN İNCELEME PANELİ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="380" x:Name="ColSidePanel"/>
            </Grid.ColumnDefinitions>

            <!-- DATA GRID (VIRTUALIZING 60FPS) -->
            <DataGrid x:Name="DgResults" Grid.Column="0" AutoGenerateColumns="False" IsReadOnly="True"
                      SelectionMode="Single" SelectionUnit="FullRow" CanUserSortColumns="True"
                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F1F5F9"
                      HeadersVisibility="Column" RowHeight="28" BorderThickness="0" Background="White"
                      EnableRowVirtualization="True" EnableColumnVirtualization="True"
                      VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                      SelectionChanged="DgResults_SelectionChanged"
                      MouseRightButtonUp="DgResults_MouseRightButtonUp"
                      Sorting="DgResults_Sorting" MouseDoubleClick="DgResults_MouseDoubleClick" KeyDown="DgResults_KeyDown">

                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem x:Name="MenuShell" Header="🪟 Windows Menüsü (Birlikte Aç, Notepad++ vb.)" Click="MenuShell_Click" FontWeight="Bold"/>
                        <Separator/>
                        <MenuItem x:Name="MenuOpen" Header="▶ Dosyayı / Klasörü Aç" Click="MenuOpen_Click"/>
                        <MenuItem x:Name="MenuOpenFolder" Header="📂 Bulunduğu Klasörü Aç ve Seç" Click="MenuOpenFolder_Click"/>
                        <Separator/>
                        <MenuItem x:Name="MenuCopyPath" Header="📋 Tam Dosya Yolunu Kopyala (Ctrl+C)" Click="MenuCopyPath_Click"/>
                        <MenuItem x:Name="MenuCopyDir" Header="📋 Yalnızca Klasör Yolunu Kopyala" Click="MenuCopyDir_Click"/>
                    </ContextMenu>
                </DataGrid.ContextMenu>

                <DataGrid.Columns>
                    <DataGridTextColumn x:Name="ColName" Header="Dosya Adı" Binding="{Binding Name}" Width="240"/>
                    <DataGridTextColumn x:Name="ColSnippet" Header="İçerik Önizleme / Satır" Binding="{Binding MatchedSnippet}" Width="280"/>
                    <DataGridTextColumn x:Name="ColPath" Header="Bulunduğu Dizin / Konum" Binding="{Binding DirectoryPath}" Width="*"/>
                    <DataGridTextColumn x:Name="ColExt" Header="Uzantı" Binding="{Binding Extension}" Width="75"/>
                    <DataGridTextColumn x:Name="ColSize" Header="Boyut" Binding="{Binding FormattedSize}" Width="90"/>
                    <DataGridTextColumn x:Name="ColDate" Header="Değiştirilme Tarihi" Binding="{Binding FormattedDate}" Width="140"/>
                </DataGrid.Columns>
            </DataGrid>

            <!-- GridSplitter Ayırıcı -->
            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="#E2E8F0"/>

            <!-- YAN PANEL: SEÇİLİ DOSYANIN EŞLEŞEN SATIRLARI (YEŞİL VURGULAMA & SATIR NUMARALARI) -->
            <Border Grid.Column="2" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#F1F5F9" Padding="10,8" BorderBrush="#CBD5E1" BorderThickness="0,0,0,1">
                        <StackPanel>
                            <TextBlock Text="📑 Eşleşen Satırlar &amp; İçerik Detayı" FontWeight="Bold" FontSize="13" Foreground="#0F766E"/>
                            <TextBlock x:Name="TxtSelectedFileInfo" Text="Dosyaya tıklayarak satırları inceleyin." FontSize="11" Foreground="#64748B" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Border>

                    <ListBox x:Name="LbLineMatches" Grid.Row="1" BorderThickness="0" Background="White"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#DCFCE7" BorderBrush="#86EFAC" BorderThickness="1" CornerRadius="4" Margin="2,3" Padding="8,5">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <!-- Satır Numarası Rozeti -->
                                        <Border Background="#16A34A" CornerRadius="3" Padding="5,2" Margin="0,0,8,0" VerticalAlignment="Top">
                                            <TextBlock Text="{Binding LineNumber, StringFormat='Satır {0}'}" Foreground="White" FontWeight="Bold" FontSize="10.5"/>
                                        </Border>
                                        <!-- Satır Metni ve Eşleşen Kelime -->
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding LineText}" FontFamily="Consolas, Courier New" FontSize="12" Foreground="#14532D" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding MatchedWord, StringFormat='🔍 Eşleşen: [{0}]'}" FontSize="10" Foreground="#15803D" FontWeight="SemiBold" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>

        <!-- STATUS BAR -->
        <Border Grid.Row="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="12,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="TxtStatus" Text="Hazırlanıyor..." VerticalAlignment="Center" Foreground="#475569"/>
                <ProgressBar x:Name="PbStatus" Grid.Column="1" Width="140" Height="14" IsIndeterminate="True" Visibility="Collapsed" Margin="0,0,12,0"/>
                <TextBlock x:Name="TxtCount" Grid.Column="2" Text="0 öğe" FontWeight="Bold" VerticalAlignment="Center" Foreground="#0F172A"/>
            </Grid>
        </Border>
    </Grid>
</Window>
