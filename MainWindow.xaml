<Window x:Class="WizFileUltra.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WizFile Ultra - Detaylı Dosya &amp; Klasör Arama (WPF .NET 4.8)"
        Height="880" Width="1380" MinHeight="720" MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        Background="#F8FAFC" FontFamily="Segoe UI" FontSize="13">

    <Window.Resources>
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Background" Value="#0EA5E9"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#0284C7"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SuccessBtn" TargetType="Button" BasedOn="{StaticResource PrimaryBtn}">
            <Setter Property="Background" Value="#10B981"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#059669"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SecondaryBtn" TargetType="Button">
            <Setter Property="Background" Value="#E2E8F0"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#CBD5E1"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ÜST PANEL -->
        <Border Grid.Row="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="14,12">
            <StackPanel>
                <!-- 1. Satır: Dosya Adı, Çoklu Dosya İçi Kelime, Klasör, Dil & Tümünü Tekrar Tara -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="190"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="170"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Dosya Adı -->
                    <TextBlock x:Name="LblFileName" Text="📄 Dosya Adı:" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,6,0" Foreground="#0F172A"/>
                    <TextBox x:Name="TxtSearch" Grid.Column="1" Padding="6,5" FontSize="13" BorderBrush="#CBD5E1" TextChanged="FilterInputChanged"
                             KeyDown="TxtSearch_KeyDown" ToolTip="Dosya adı yazın. Enter veya [+] ile birden fazla dosya adı ekleyebilirsiniz."/>

                    <Button x:Name="BtnAddFileName" Grid.Column="2" Content="➕" Margin="4,0,10,0" Width="30" Height="28"
                            Style="{StaticResource SuccessBtn}" Click="BtnAddFileName_Click" ToolTip="Bu dosya adını rozetlere ekler."/>

                    <!-- Dosya İçi Aranacak Kelime -->
                    <TextBlock x:Name="LblContentSearch" Grid.Column="3" Text="🔍 Dosya İçi Kelime:" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,6,0" Foreground="#0284C7"/>
                    <TextBox x:Name="TxtContentSearch" Grid.Column="4" Padding="6,5" FontSize="13" BorderBrush="#38BDF8" TextChanged="FilterInputChanged"
                             KeyDown="TxtContentSearch_KeyDown" ToolTip="Dosya içinde aranacak kelime yazın. Enter veya [+] ile birden fazla kelime ekleyebilirsiniz."/>

                    <Button x:Name="BtnAddWord" Grid.Column="5" Content="➕" Margin="4,0,10,0" Width="30" Height="28"
                            Style="{StaticResource PrimaryBtn}" Click="BtnAddWord_Click" ToolTip="Bu kelimeyi dosya içi arama rozetlerine ekler."/>

                    <!-- Klasör -->
                    <TextBlock x:Name="LblFolderName" Grid.Column="6" Text="📁 Klasör:" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,6,0" Foreground="#0F172A"/>
                    <TextBox x:Name="TxtFolderNameSearch" Grid.Column="7" Padding="6,5" FontSize="13" BorderBrush="#CBD5E1" TextChanged="FilterInputChanged"/>

                    <!-- Dil Seçimi -->
                    <StackPanel Grid.Column="8" Orientation="Horizontal" Margin="8,0,0,0">
                        <TextBlock Text="🌐" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <ComboBox x:Name="CmbLanguage" Width="82" Height="30" VerticalContentAlignment="Center">
                            <ComboBoxItem Content="TR (Türkçe)" Tag="tr" IsSelected="True"/>
                            <ComboBoxItem Content="EN (English)" Tag="en"/>
                            <ComboBoxItem Content="DE (Deutsch)" Tag="de"/>
                            <ComboBoxItem Content="FR (Français)" Tag="fr"/>
                            <ComboBoxItem Content="ES (Español)" Tag="es"/>
                            <ComboBoxItem Content="RU (Русский)" Tag="ru"/>
                            <ComboBoxItem Content="ZH (中文)" Tag="zh"/>
                            <ComboBoxItem Content="JA (日本語)" Tag="ja"/>
                            <ComboBoxItem Content="AR (العربية)" Tag="ar"/>
                        </ComboBox>
                    </StackPanel>

                    <Button x:Name="BtnRescanAll" Grid.Column="9" Margin="8,0,0,0" Content="⚡ Tümünü Tekrar Tara"
                            Style="{StaticResource PrimaryBtn}" Click="BtnRescanAll_Click"/>
                </Grid>

                <!-- Eklenen Dosya Adı ve Dosya İçi Kelime Rozetleri -->
                <WrapPanel Orientation="Horizontal" Margin="90,0,0,6">
                    <!-- Dosya Adı Rozetleri -->
                    <ItemsControl x:Name="IcFileNames">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#FEF3C7" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="12" Margin="0,0,6,6" Padding="8,3">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="📄 " FontSize="11"/>
                                        <TextBlock Text="{Binding}" Foreground="#92400E" FontWeight="SemiBold" FontSize="11" Margin="2,0,6,0" VerticalAlignment="Center"/>
                                        <Button Content="✖" Foreground="#EF4444" Background="Transparent" BorderThickness="0" Cursor="Hand"
                                                FontSize="10" Padding="2,0" Tag="{Binding}" Click="BtnRemoveFileName_Click"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Dosya İçi Aranacak Kelime Rozetleri -->
                    <ItemsControl x:Name="IcWords">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#E0F2FE" BorderBrush="#BAE6FD" BorderThickness="1" CornerRadius="12" Margin="0,0,6,6" Padding="8,3">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🔍 " FontSize="11"/>
                                        <TextBlock Text="{Binding}" Foreground="#0369A1" FontWeight="Bold" FontSize="11" Margin="2,0,6,0" VerticalAlignment="Center"/>
                                        <Button Content="✖" Foreground="#EF4444" Background="Transparent" BorderThickness="0" Cursor="Hand"
                                                FontSize="10" Padding="2,0" Tag="{Binding}" Click="BtnRemoveWord_Click"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </WrapPanel>

                <!-- 2. Satır: Hedef Dizinler (+ Rozetler) & Sürücü -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="LblTargetFolders" Text="📍 Hedef Dizinler:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,0" Foreground="#334155"/>
                    <TextBox x:Name="TxtFolderInput" Grid.Column="1" Padding="6,4" BorderBrush="#CBD5E1"/>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="8,0,0,0">
                        <Button x:Name="BtnBrowse" Content="Gözat..." Width="70" Height="28" Style="{StaticResource SecondaryBtn}" Click="BtnBrowse_Click"/>
                        <Button x:Name="BtnAddFolder" Content="➕ Dizin Ekle" Margin="6,0,0,0" Width="105" Height="28" Style="{StaticResource SuccessBtn}" Click="BtnAddFolder_Click"/>
                    </StackPanel>

                    <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="14,0,0,0">
                        <TextBlock x:Name="LblDrive" Text="Sürücü:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#64748B"/>
                        <ComboBox x:Name="CmbDrives" Width="125" Height="28" VerticalContentAlignment="Center"/>
                    </StackPanel>

                    <Button x:Name="BtnScanSelectedFolders" Grid.Column="4" Margin="10,0,0,0" Content="📂 Yalnızca Seçili Dizinleri İndeksle"
                            Style="{StaticResource SecondaryBtn}" Click="BtnScanSelectedFolders_Click"/>
                </Grid>

                <!-- Eklenen Hedef Dizin Rozetleri (Folder Chips) -->
                <ItemsControl x:Name="IcFolders" Margin="110,0,0,8">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="12" Margin="0,0,6,6" Padding="8,3">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📁 " FontSize="11"/>
                                    <TextBlock Text="{Binding}" Foreground="#1E40AF" FontSize="11" Margin="2,0,6,0" VerticalAlignment="Center"/>
                                    <Button Content="✖" Foreground="#EF4444" Background="Transparent" BorderThickness="0" Cursor="Hand"
                                            FontSize="10" Padding="2,0" Tag="{Binding}" Click="BtnRemoveFolder_Click"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- 3. Satır: Kategoriler, Uzantılar, Boyut, Tarih, Dosya/Klasör Radyoları -->
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="LblCategory" Text="Kategori:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,6,0" Foreground="#334155"/>
                    <ComboBox x:Name="CmbCategory" Grid.Column="1" Height="28" VerticalContentAlignment="Center" SelectionChanged="CmbCategory_SelectionChanged">
                        <ComboBoxItem Content="Hepsi"/>
                        <ComboBoxItem Content="Kod / Yazı" IsSelected="True"/>
                        <ComboBoxItem Content="Resimler"/>
                        <ComboBoxItem Content="Videolar"/>
                        <ComboBoxItem Content="Belgeler"/>
                        <ComboBoxItem Content="Arşivler"/>
                        <ComboBoxItem Content="Müzikler"/>
                    </ComboBox>

                    <TextBlock x:Name="LblExtensions" Grid.Column="2" Text="Uzantılar:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="10,0,6,0" Foreground="#334155"/>
                    <TextBox x:Name="TxtCustomExt" Grid.Column="3" Padding="4,4" BorderBrush="#CBD5E1"
                             Text=".txt .cpp .h .c .cs .py .js .ts .html .css .json .xml .md .log"
                             TextChanged="FilterInputChanged"/>

                    <TextBlock x:Name="LblSize" Grid.Column="4" Text="Boyut:" VerticalAlignment="Center" Margin="10,0,6,0" Foreground="#64748B"/>
                    <ComboBox x:Name="CmbSize" Grid.Column="5" Height="28" VerticalContentAlignment="Center">
                        <ComboBoxItem Content="Herhangi" IsSelected="True"/>
                        <ComboBoxItem Content="&lt; 1 MB"/>
                        <ComboBoxItem Content="1 MB - 100 MB"/>
                        <ComboBoxItem Content="100 MB - 1 GB"/>
                        <ComboBoxItem Content="&gt; 1 GB"/>
                    </ComboBox>

                    <TextBlock x:Name="LblDate" Grid.Column="6" Text="Tarih:" VerticalAlignment="Center" Margin="10,0,6,0" Foreground="#64748B"/>
                    <ComboBox x:Name="CmbDate" Grid.Column="7" Height="28" VerticalContentAlignment="Center">
                        <ComboBoxItem Content="Herhangi" IsSelected="True"/>
                        <ComboBoxItem Content="Bugün / Today"/>
                        <ComboBoxItem Content="Son 7 Gün / 7 Days"/>
                        <ComboBoxItem Content="Son 30 Gün / 30 Days"/>
                        <ComboBoxItem Content="Bu Yıl / This Year"/>
                    </ComboBox>

                    <StackPanel Grid.Column="8" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <RadioButton x:Name="RbAll" Content="Tümü" IsChecked="True" Margin="0,0,8,0"/>
                        <RadioButton x:Name="RbFilesOnly" Content="Dosyalar" Margin="0,0,8,0"/>
                        <RadioButton x:Name="RbFoldersOnly" Content="Klasörler"/>
                    </StackPanel>
                </Grid>

                <!-- 4. Satır: Son X Dakika Filtresi & Canlı Otomatik Güncelleme -->
                <Border Background="#F1F5F9" CornerRadius="4" Padding="8,5" Margin="0,6,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <CheckBox x:Name="ChkLastMinutes" Content="⏱ Sadece Son (dk) Değişenleri Göster:" FontWeight="SemiBold"
                                  VerticalAlignment="Center" Foreground="#1E293B" Click="ChkLastMinutes_Click"/>
                        
                        <TextBox x:Name="TxtLastMinutes" Grid.Column="1" Text="10" Width="45" Padding="4,2" Margin="6,0,16,0"
                                 TextAlignment="Center" FontWeight="Bold" BorderBrush="#CBD5E1"/>

                        <CheckBox x:Name="ChkAutoRefresh" Grid.Column="2" Content="🔄 Canlı Otomatik Güncelle (sn):" FontWeight="SemiBold"
                                  VerticalAlignment="Center" Foreground="#0284C7" Click="ChkAutoRefresh_Click"/>

                        <TextBox x:Name="TxtAutoRefreshInterval" Grid.Column="3" Text="5" Width="45" Padding="4,2" Margin="6,0,10,0"
                                 TextAlignment="Center" FontWeight="Bold" BorderBrush="#CBD5E1"/>

                        <TextBlock x:Name="LblLiveStatus" Grid.Column="4" Text="● Canlı Takip Devrede" Foreground="#10B981" FontWeight="Bold"
                                   VerticalAlignment="Center" Visibility="Collapsed" Margin="6,0,0,0"/>

                        <Button x:Name="BtnManualRefresh" Grid.Column="6" Content="🔄 Şimdi Yenile" HorizontalAlignment="Right"
                                Padding="10,3" Style="{StaticResource SecondaryBtn}" Click="BtnManualRefresh_Click"/>
                    </Grid>
                </Border>
            </StackPanel>
        </Border>

        <!-- DATA GRID (VIRTUALIZING 60FPS) -->
        <DataGrid x:Name="DgResults" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionMode="Single" SelectionUnit="FullRow" CanUserSortColumns="True"
                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F1F5F9"
                  HeadersVisibility="Column" RowHeight="28" BorderThickness="0" Background="White"
                  EnableRowVirtualization="True" EnableColumnVirtualization="True"
                  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                  Sorting="DgResults_Sorting" MouseDoubleClick="DgResults_MouseDoubleClick" KeyDown="DgResults_KeyDown">

            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem x:Name="MenuOpen" Header="▶ Dosyayı / Klasörü Aç" Click="MenuOpen_Click"/>
                    <MenuItem x:Name="MenuOpenFolder" Header="📂 Bulunduğu Klasörü Aç ve Seç" Click="MenuOpenFolder_Click"/>
                    <Separator/>
                    <MenuItem x:Name="MenuCopyPath" Header="📋 Tam Dosya Yolunu Kopyala (Ctrl+C)" Click="MenuCopyPath_Click"/>
                    <MenuItem x:Name="MenuCopyDir" Header="📋 Yalnızca Klasör Yolunu Kopyala" Click="MenuCopyDir_Click"/>
                </ContextMenu>
            </DataGrid.ContextMenu>

            <DataGrid.Columns>
                <DataGridTextColumn x:Name="ColName" Header="Adı" Binding="{Binding Name}" Width="250"/>
                <DataGridTextColumn x:Name="ColSnippet" Header="İçerik Önizleme / Satır" Binding="{Binding MatchedSnippet}" Width="300"/>
                <DataGridTextColumn x:Name="ColPath" Header="Bulunduğu Klasör / Yol" Binding="{Binding DirectoryPath}" Width="*"/>
                <DataGridTextColumn x:Name="ColExt" Header="Uzantı" Binding="{Binding Extension}" Width="75"/>
                <DataGridTextColumn x:Name="ColSize" Header="Boyut" Binding="{Binding FormattedSize}" Width="95"/>
                <DataGridTextColumn x:Name="ColDate" Header="Değiştirilme Tarihi" Binding="{Binding FormattedDate}" Width="145"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- STATUS BAR -->
        <Border Grid.Row="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="12,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="TxtStatus" Text="Hazırlanıyor..." VerticalAlignment="Center" Foreground="#475569"/>
                <ProgressBar x:Name="PbStatus" Grid.Column="1" Width="140" Height="14" IsIndeterminate="True" Visibility="Collapsed" Margin="0,0,12,0"/>
                <TextBlock x:Name="TxtCount" Grid.Column="2" Text="0 öğe" FontWeight="Bold" VerticalAlignment="Center" Foreground="#0F172A"/>
            </Grid>
        </Border>
    </Grid>
</Window>
